name: dirextalk-worker-__FLAVOR__-install-1-1-3
description: Install the Dirextalk Worker 1.1.3 toolchain and pinned Pi runtime.
schemaVersion: 1.0
phases:
  - name: build
    steps:
      - name: InstallToolchain
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              export DEBIAN_FRONTEND=noninteractive
              for attempt in 1 2 3; do
                apt-get update && break
                test "$attempt" -lt 3
                sleep 10
              done
              apt-get install -y --no-install-recommends \
                build-essential caddy ca-certificates curl git gh golang-go gzip jq \
                html2text libxml2-utils pandoc poppler-utils python3-bs4 python3-httpx python3-lxml qpdf \
                nodejs npm python-is-python3 python3 python3-pip python3-venv \
                ripgrep tar w3m weasyprint
              install -d -m 0755 /opt/dirextalk-worker/pi/0.84.4
              install -d -m 0755 /opt/dirextalk-worker/uv/0.12.9
              install -d -m 0700 /var/lib/dirextalk-worker
              printf '%s\n' '__FLAVOR__' >/usr/local/share/dirextalk-worker-flavor
              pi_archive=$(mktemp)
              uv_archive=$(mktemp)
              trap 'rm -f -- "$pi_archive" "$uv_archive"' EXIT
              curl --retry 3 --retry-all-errors --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
                --output "$pi_archive" \
                'https://github.com/earendil-works/pi/releases/download/v0.84.4/pi-linux-x64.tar.gz'
              printf '%s  %s\n' \
                'c2f3c3e6a1850bd87654cc3ca8811013272397c3d042a4e2a64c43ee1b423972' \
                "$pi_archive" | sha256sum -c -
              tar -xzf "$pi_archive" -C /opt/dirextalk-worker/pi/0.84.4 --strip-components=1
              test "$(/opt/dirextalk-worker/pi/0.84.4/pi --version)" = '0.84.4'
              curl --retry 3 --retry-all-errors --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
                --output "$uv_archive" \
                'https://github.com/astral-sh/uv/releases/download/0.12.9/uv-x86_64-unknown-linux-gnu.tar.gz'
              printf '%s  %s\n' \
                'ec7a99cd05e0cd7f80243f135ce1361c76835cb0ee60055d14d20eba8eba1460' \
                "$uv_archive" | sha256sum -c -
              tar -xzf "$uv_archive" -C /opt/dirextalk-worker/uv/0.12.9 --strip-components=1
              /opt/dirextalk-worker/uv/0.12.9/uv --version | grep -Eq '^uv 0\.12\.9( \([^)]*\))?$'
              /opt/dirextalk-worker/uv/0.12.9/uvx --version | grep -Eq '^uvx 0\.12\.9( \([^)]*\))?$'
              install -d -m 0755 /opt/dirextalk-worker/bin
              printf '%s\n' '#!/bin/sh' 'exec /opt/dirextalk-worker/pi/0.84.4/pi "$@"' \
                >/opt/dirextalk-worker/bin/pi
              chmod 0755 /opt/dirextalk-worker/bin/pi
              install -m 0755 /opt/dirextalk-worker/uv/0.12.9/uv /opt/dirextalk-worker/bin/uv
              install -m 0755 /opt/dirextalk-worker/uv/0.12.9/uvx /opt/dirextalk-worker/bin/uvx
              ln -sfn /opt/dirextalk-worker/bin/pi /usr/local/bin/pi
              ln -sfn /opt/dirextalk-worker/bin/uv /usr/local/bin/uv
              ln -sfn /opt/dirextalk-worker/bin/uvx /usr/local/bin/uvx
              chmod 0755 /opt/dirextalk-worker/pi/0.84.4/pi /opt/dirextalk-worker/uv/0.12.9/uv /opt/dirextalk-worker/uv/0.12.9/uvx
              versions=$(jq -n \
                --arg python "$(python3 --version 2>&1)" \
                --arg pip "$(python3 -m pip --version)" \
                --arg node "$(node --version)" \
                --arg npm "$(npm --version)" \
                --arg git "$(git --version)" \
                --arg gh "$(gh --version | head -n1)" \
                --arg go "$(go version)" \
                --arg cc "$(cc --version | head -n1)" \
                --arg curl "$(curl --version | head -n1)" \
                --arg tar "$(tar --version | head -n1)" \
                --arg gzip "$(gzip --version | head -n1)" \
                --arg jq "$(jq --version)" \
                --arg rg "$(rg --version | head -n1)" \
                --arg uv "$(uv --version)" \
                --arg uvx "$(uvx --version)" \
                --arg pandoc "$(pandoc --version | head -n1)" \
                --arg weasyprint "$(weasyprint --version)" \
                --arg qpdf "$(qpdf --version | head -n1)" \
                --arg pdfinfo "$(pdfinfo -v 2>&1 | head -n1)" \
                --arg html2text "$(dpkg-query -W -f='${Version}' html2text)" \
                --arg w3m "$(dpkg-query -W -f='${Version}' w3m)" \
                --arg xmllint "$(dpkg-query -W -f='${Version}' libxml2-utils)" \
                --arg httpx "$(python3 -c 'from importlib.metadata import version; print(version("httpx"))')" \
                --arg beautifulsoup4 "$(python3 -c 'from importlib.metadata import version; print(version("beautifulsoup4"))')" \
                --arg lxml "$(python3 -c 'from importlib.metadata import version; print(version("lxml"))')" \
                '{python:$python,pip:$pip,node:$node,npm:$npm,git:$git,gh:$gh,go:$go,cc:$cc,curl:$curl,tar:$tar,gzip:$gzip,jq:$jq,ripgrep:$rg,uv:$uv,uvx:$uvx,pandoc:$pandoc,weasyprint:$weasyprint,qpdf:$qpdf,pdfinfo:$pdfinfo,html2text:$html2text,w3m:$w3m,xmllint:$xmllint,httpx:$httpx,beautifulsoup4:$beautifulsoup4,lxml:$lxml}')
              jq -n --arg flavor '__FLAVOR__' --arg gpu_families '__GPU_FAMILIES__' --argjson tools "$versions" \
                '{schema:1,image_version:"1.1.3",flavor:$flavor,pi_version:"0.84.4",tool_baseline:"1",tested:true,gpu_supported_families:$gpu_families,tools:$tools}' \
                >/opt/dirextalk-worker/manifest.json
              chmod 0644 /opt/dirextalk-worker/manifest.json
      - name: RemoveBuildResidue
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              apt-get clean
              rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
              rm -rf /root/.cache /root/.npm /root/.config/gh /root/.aws
              rm -f /root/.bash_history /root/.git-credentials /root/.npmrc
              if id ubuntu >/dev/null 2>&1; then
                home=$(getent passwd ubuntu | cut -d: -f6)
                rm -rf "$home/.cache" "$home/.npm" "$home/.config/gh" "$home/.aws"
                rm -f "$home/.bash_history" "$home/.git-credentials" "$home/.npmrc"
              fi
              find /tmp /var/tmp -mindepth 1 -xdev -delete
  - name: validate
    steps:
      - name: ValidateInstalledRuntime
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              test "$(pi --version)" = '0.84.4'
              uv --version | grep -Eq '^uv 0\.12\.9( \([^)]*\))?$'
              uvx --version | grep -Eq '^uvx 0\.12\.9( \([^)]*\))?$'
              test "$(jq -r .schema /opt/dirextalk-worker/manifest.json)" = '1'
              test "$(jq -r .image_version /opt/dirextalk-worker/manifest.json)" = '1.1.3'
              test "$(jq -r .tested /opt/dirextalk-worker/manifest.json)" = 'true'
              test "$(cat /usr/local/share/dirextalk-worker-flavor)" = '__FLAVOR__'
              command -v python python3 pip npm node git gh go cc caddy curl tar gzip jq rg uv uvx \
                pandoc weasyprint qpdf pdfinfo pdftotext html2text w3m xmllint
              test -d /var/lib/dirextalk-worker
              test ! -L /var/lib/dirextalk-worker
