name: dirextalk-worker-__FLAVOR__-test-1-1-4
description: Qualify Dirextalk Worker 1.1.4, including offline content tooling and reboot persistence.
schemaVersion: 1.0
phases:
  - name: test
    steps:
      - name: VerifyToolsAndPi
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              command -v python python3 pip npm node git gh go cc caddy curl tar gzip jq rg uv uvx \
                pandoc weasyprint qpdf pdfinfo pdftotext html2text w3m xmllint
              python --version
              python3 -m pip --version
              python3 -m venv --help >/dev/null
              node --version
              npm --version
              git --version
              gh --version
              go version
              cc --version
              caddy version
              curl --version
              tar --version
              gzip --version
              jq --version
              rg --version
              test "$(pi --version)" = '0.84.4'
              test "$(/opt/dirextalk-worker/bin/pi --version)" = '0.84.4'
              uv --version | grep -E '^uv 0\.12\.9( \([^)]*\))?$' >/dev/null
              uvx --version | grep -E '^uvx 0\.12\.9( \([^)]*\))?$' >/dev/null
              test "$(stat -c '%U:%G:%a' /opt/dirextalk-worker/manifest.json)" = 'root:root:644'
              test "$(stat -c '%U:%G:%a' /opt/dirextalk-worker/bin/pi)" = 'root:root:755'
              timeout 15 pi --help >/dev/null
      - name: VerifyOfflinePythonWebAndPDFWorkflow
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              root=$(mktemp -d /tmp/dirextalk-image-test.XXXXXX)
              trap 'rm -rf -- "$root"' EXIT
              UV_PYTHON_DOWNLOADS=never uv --offline venv --python /usr/bin/python3 "$root/.venv"
              "$root/.venv/bin/python" -c 'import sys; assert sys.version_info >= (3, 12)'
              python3 - <<'PY'
              import httpx
              from bs4 import BeautifulSoup
              from lxml import html

              transport = httpx.MockTransport(lambda request: httpx.Response(
                  200,
                  request=request,
                  text='<html><head><title>Dirextalk</title></head><body><main><a href="/docs">Worker docs</a></main></body></html>',
              ))
              body = httpx.Client(transport=transport).get('https://example.invalid/').text
              assert BeautifulSoup(body, 'html.parser').title.string == 'Dirextalk'
              assert html.fromstring(body).xpath('string(//main/a)') == 'Worker docs'
              PY
              printf '# Dirextalk Worker\n\nOffline PDF smoke test.\n' >"$root/doc.md"
              pandoc "$root/doc.md" --standalone --output "$root/doc.html"
              weasyprint "$root/doc.html" "$root/doc.pdf"
              pdfinfo "$root/doc.pdf" | grep '^Pages:' >/dev/null
              pdftotext "$root/doc.pdf" "$root/doc.txt"
              grep -q 'Dirextalk Worker' "$root/doc.txt"
              qpdf --check "$root/doc.pdf"
              html2text "$root/doc.html" | grep 'Dirextalk Worker' >/dev/null
              w3m -dump "$root/doc.html" | grep 'Dirextalk Worker' >/dev/null
              xmllint --html --recover --noout "$root/doc.html" 2>"$root/xmllint.log"
      - name: VerifyOfflineGitWorkflow
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              root=$(mktemp -d /tmp/dirextalk-image-test.XXXXXX)
              trap 'rm -rf -- "$root"' EXIT
              git init --bare "$root/origin.git"
              git clone "$root/origin.git" "$root/source"
              cd "$root/source"
              git config user.name 'Dirextalk Image Test'
              git config user.email 'image-test@invalid.example'
              printf 'def add(a, b):\n    return a + b\n' >sample.py
              printf 'import unittest\nfrom sample import add\nclass T(unittest.TestCase):\n    def test_add(self): self.assertEqual(add(2, 3), 5)\nif __name__ == "__main__": unittest.main()\n' >test_sample.py
              printf '{"scripts":{"test":"node -e \\"if (2 + 3 !== 5) process.exit(1)\\""}}\n' >package.json
              git add sample.py test_sample.py package.json
              git commit -m baseline
              git push origin HEAD:main
              cd "$root"
              git clone --no-local --branch main "$root/origin.git" work
              cd work
              printf '\n# image-builder-edit\n' >>sample.py
              python3 -m unittest -v
              npm test
              test -n "$(git diff -- sample.py)"
      - name: VerifyGPUStack
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              if test '__FLAVOR__' = gpu; then
                nvidia-smi -L
                if command -v nvcc >/dev/null 2>&1; then nvcc --version; else /usr/local/cuda/bin/nvcc --version; fi
                nvidia-ctk --version
                nvidia-container-cli --version
                containerd --version
                nerdctl --version
                if command -v soci-snapshotter-grpc >/dev/null 2>&1; then
                  soci-snapshotter-grpc --version
                elif command -v soci >/dev/null 2>&1; then
                  soci --version
                else
                  echo 'SOCI executable is missing' >&2
                  exit 1
                fi
                systemctl is-enabled containerd.service
                systemctl is-active containerd.service
                ctr plugins ls | awk '$1 == "io.containerd.snapshotter.v1" && $2 == "soci" && $NF == "ok" { found = 1 } END { exit !found }'
                validation_image='nvidia/cuda:12.8.1-base-ubuntu24.04@sha256:e711c99333fdfe8ae1e677b4972be6c5021f0128a1d31f775c7e58d88921b6a9'
                nerdctl pull --platform linux/amd64 "$validation_image"
                nerdctl run --rm --platform linux/amd64 --gpus all "$validation_image" nvidia-smi
              fi
      - name: WritePersistenceProbe
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              test -d /var/lib/dirextalk-worker
              test ! -L /var/lib/dirextalk-worker
              boot=$(cat /proc/sys/kernel/random/boot_id)
              nonce=$(cat /proc/sys/kernel/random/uuid)
              printf '%s\n%s\n' "$boot" "$nonce" >/var/lib/dirextalk-worker/.image-builder-persistence-probe
              chmod 0600 /var/lib/dirextalk-worker/.image-builder-persistence-probe
      - name: RebootForPersistenceTest
        action: Reboot
        onFailure: Abort
        inputs:
          delaySeconds: 5
      - name: VerifyPersistenceAfterReboot
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              probe=/var/lib/dirextalk-worker/.image-builder-persistence-probe
              test -f "$probe" && test ! -L "$probe"
              before=$(sed -n '1p' "$probe")
              nonce=$(sed -n '2p' "$probe")
              test -n "$nonce"
              test "$before" != "$(cat /proc/sys/kernel/random/boot_id)"
              rm -f "$probe"
              if test '__FLAVOR__' = gpu; then
                systemctl is-active containerd.service
                nvidia-smi -L
                ctr plugins ls | awk '$1 == "io.containerd.snapshotter.v1" && $2 == "soci" && $NF == "ok" { found = 1 } END { exit !found }'
                validation_image='nvidia/cuda:12.8.1-base-ubuntu24.04@sha256:e711c99333fdfe8ae1e677b4972be6c5021f0128a1d31f775c7e58d88921b6a9'
                nerdctl run --rm --platform linux/amd64 --gpus all "$validation_image" nvidia-smi
              fi
      - name: VerifyNoBuildResidue
        action: ExecuteBash
        onFailure: Abort
        inputs:
          commands:
            - |
              set -euo pipefail
              trap 'printf "residue check failed at line %s (status %s)\n" "$LINENO" "$?" >&2' ERR
              forbidden=$(find /root /home/ubuntu /tmp /var/tmp -xdev \( -type f -o -type l \) \( \
                -name '.bash_history' -o -name '.zsh_history' -o \
                -name '.git-credentials' -o -name '.npmrc' -o \
                -name 'credentials' -path '*/.aws/*' -o \
                -name 'hosts.yml' -path '*/.config/gh/*' -o \
                -name 'authorized_keys' \( -type l -o -size +0c \) -o \
                -name 'id_rsa' -o -name 'id_dsa' -o -name 'id_ecdsa' -o -name 'id_ed25519' -o \
                -name '*.pem' -o -name '*.key' -o \
                -type l \( -name '.ssh' -o -name '.aws' -o -path '*/.config/gh' \) \
                \) -print)
              test -z "$forbidden" || { printf 'forbidden residue:\n%s\n' "$forbidden" >&2; exit 1; }
              apt_residue=$(find /var/lib/apt/lists /var/cache/apt/archives \( -type f -o -type l \) -print -quit)
              test -z "$apt_residue"
              # Boot and the test runner create runtime temp entries; only our build/test roots are forbidden.
              temporary_residue=$(find /tmp /var/tmp -xdev -mindepth 1 -maxdepth 1 \
                \( -name 'dirextalk-image-test.*' -o -name 'tmp.*' \) -print)
              test -z "$temporary_residue" || { printf 'temporary build/test residue:\n%s\n' "$temporary_residue" >&2; exit 1; }
              env | awk -F= 'toupper($1) ~ /^(AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN|GITHUB_TOKEN|GH_TOKEN|NPM_TOKEN)$/ { found = 1 } END { exit found ? 1 : 0 }'
              test "$(pi --version)" = '0.84.4'
              uv --version | grep -E '^uv 0\.12\.9( \([^)]*\))?$' >/dev/null
